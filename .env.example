# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB Atlas connection string (include the database name, e.g. /umrah)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/umrah?retryWrites=true&w=majority

# Long random string used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=change-me
